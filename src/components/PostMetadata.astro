---
import { Image } from 'astro:assets'
import { FaBitbucket, FaGithub, FaLink, FaWordpressSimple } from 'react-icons/fa6'

export interface Props {
  time: string
  date: string
  heroImage?: any
  description: string
  ghUrl?: string
  bbUrl?: string
  wpUrl?: string
  liveUrl?: string
}

const { time, date, heroImage, description, ghUrl, bbUrl, wpUrl, liveUrl } = Astro.props

const linkClass =
  'inline-flex items-center rounded-lg! border border-onemagenta bg-[#24292F]! px-5 py-2.5 text-center text-sm! font-medium! text-white! no-underline! hover:bg-[#24292F]/90! focus:outline-none! focus:ring-4! focus:ring-[#24292F]/50! dark:hover:bg-[#050708]/30! dark:focus:ring-gray-500!'
const iconClass = 'mr-2 h-4 w-4'
---

<div class="my-3 flex flex-col justify-between gap-5 md:flex-row md:gap-0">
  <div>
    <p class="text-lg text-oneblack dark:text-slate-300">Samin Yaser</p>
    <span class="text-onegrey2 dark:text-onewhite">{time} minute read</span>
    <span class="text-onegrey1 dark:text-slate-300"> · {date}</span>
  </div>
  <div class="flex flex-wrap items-start gap-2 md:justify-end">
    {
      ghUrl && (
        <a href={ghUrl} target="_blank" rel="noreferrer" class={linkClass}>
          <FaGithub className={iconClass} aria-hidden={true} />
          View on GitHub
        </a>
      )
    }
    {
      bbUrl && (
        <a href={bbUrl} target="_blank" rel="noreferrer" class={linkClass}>
          <FaBitbucket className={iconClass} aria-hidden={true} />
          View on Bitbucket
        </a>
      )
    }
    {
      wpUrl && (
        <a href={wpUrl} target="_blank" rel="noreferrer" class={linkClass}>
          <FaWordpressSimple className={iconClass} aria-hidden={true} />
          WordPress.org
        </a>
      )
    }
    {
      liveUrl && (
        <a href={liveUrl} target="_blank" rel="noreferrer" class={linkClass}>
          <FaLink className={iconClass} aria-hidden={true} />
          Live Demo
        </a>
      )
    }
  </div>
</div>

{
  heroImage && (
    <>
      <br />
      <Image src={heroImage} alt="test image" className="rounded-lg" />
      <br />
    </>
  )
}

<div class="mt-5 mb-3 md:mt-3">
  <p>{description}</p>
</div>

<hr class="mb-3 h-px" />

<atomic-ownership-race class="race-lab">
  <div class="race-copy">
    <p class="eyebrow">Race-condition simulator</p>
    <h3>Two workers, one key</h3>
    <p>Advance the execution. The request tokens physically compete for one database gate.</p>
  </div>

  <div class="mode" role="group" aria-label="Coordination strategy">
    <button type="button" data-mode="unsafe" aria-pressed="true">Read, then create</button>
    <button type="button" data-mode="atomic" aria-pressed="false">Unique atomic claim</button>
  </div>

  <div class="race-board" data-mode="unsafe" data-step="0" data-result="active" aria-label="Animated ownership race between two workers">
    <div class="route route-a"></div><div class="route route-b"></div>
    <div class="worker worker-a"><span>A</span><strong>ready</strong></div>
    <div class="database"><div class="db-top"></div><span>Scoped key</span><strong>absent</strong><small>unique gate</small></div>
    <div class="worker worker-b"><span>B</span><strong>ready</strong></div>
    <div class="claim-token token-a"><b>A</b><small>op_7F2</small></div>
    <div class="claim-token token-b"><b>B</b><small>op_7F2</small></div>
    <div class="lock-gate"><i></i><span>LOCK</span></div>
    <div class="wait-wave"><i></i><i></i><i></i></div>
    <div class="effect-tray"><span>protected effects</span><div><i>$</i><i>$</i></div></div>
  </div>

  <div class="event-log" aria-live="polite"><span>Step 0</span><p>Both workers receive the same logical operation.</p></div>
  <div class="controls">
    <button type="button" data-action="reset">Reset</button>
    <button type="button" data-action="next">Next event <span aria-hidden="true">→</span></button>
  </div>
  <p class="lesson">The database must decide ownership. Application-level timing cannot.</p>
</atomic-ownership-race>

<script>
  class AtomicOwnershipRace extends HTMLElement {
    mode = 'unsafe'
    step = 0
    connectedCallback() {
      this.renderStep()
      this.querySelectorAll('[data-mode]').forEach((button) => button.addEventListener('click', () => {
        this.mode = button.dataset.mode
        this.step = 0
        this.querySelectorAll('[data-mode]').forEach((item) => item.setAttribute('aria-pressed', String(item === button)))
        this.renderStep()
      }))
      this.querySelector('[data-action="reset"]').addEventListener('click', () => { this.step = 0; this.renderStep() })
      this.querySelector('[data-action="next"]').addEventListener('click', () => { this.step = Math.min(this.step + 1, 4); this.renderStep() })
    }
    renderStep() {
      const unsafe = [
        ['ready','absent','ready','Both workers receive the same logical operation.'],
        ['reads absent','absent','ready','Worker A reaches the database, reads an empty key, then moves past the read.'],
        ['reads absent','absent','reads absent','Worker B reaches the same empty read before A writes ownership.'],
        ['creates effect','still absent','creates effect','Both tokens leave the database as owners and start the mutation.'],
        ['completed','written late','completed','Two effect markers escape. The ownership record arrives after the decision.'],
      ]
      const atomic = [
        ['ready','absent','ready','Both workers receive the same logical operation.'],
        ['claims','A owns key','ready','A crosses the unique gate. The database closes it atomically behind A.'],
        ['owns','A owns key','conflict waits','B reaches the gate, collides with the lock, and waits instead of becoming an owner.'],
        ['creates effect','A owns key','waiting','Only A leaves the gate to perform the protected mutation.'],
        ['returns result','completed','replays result','One effect returns. B follows the stored replay path instead of creating another.'],
      ]
      const row = (this.mode === 'unsafe' ? unsafe : atomic)[this.step]
      const board = this.querySelector('.race-board')
      board.setAttribute('data-mode', this.mode)
      board.setAttribute('data-step', String(this.step))
      board.setAttribute('data-result', this.step === 4 ? (this.mode === 'atomic' ? 'safe' : 'danger') : 'active')
      this.querySelector('.worker-a strong').textContent = row[0]
      this.querySelector('.database strong').textContent = row[1]
      this.querySelector('.worker-b strong').textContent = row[2]
      this.querySelector('.event-log span').textContent = `Step ${this.step}`
      this.querySelector('.event-log p').textContent = row[3]
      this.querySelector('.lesson').textContent = this.step === 4
        ? this.mode === 'atomic'
          ? 'One gate, one owner, one effect. The conflicting worker can only replay the stored result.'
          : 'Two readers crossed an unguarded decision point. The late record cannot pull the second effect back.'
        : 'The database must decide ownership. Application-level timing cannot.'
    }
  }
  if (!customElements.get('atomic-ownership-race')) customElements.define('atomic-ownership-race', AtomicOwnershipRace)
</script>

<style>
  .race-lab{--bg:#fff8e7;--panel:#fff;--board:#fffdf6;--text:#282c34;--muted:#685a43;--border:#d4a633;--db:#283447;--dbtext:#fff;--log:#f4e3b7;--blue:#2f80ed;--purple:#a24ac3;--green:#4d8b31;--red:#c43d4d;--gold:#a66500;display:block;margin:2.5rem 0;padding:clamp(1rem,3vw,2rem);border-radius:1.25rem;background:var(--bg);color:var(--text);border:1px solid var(--border);box-shadow:0 18px 55px rgba(90,67,20,.14);transition:background .25s,color .25s,border-color .25s}

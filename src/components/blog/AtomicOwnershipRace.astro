  .eyebrow{margin:0!important;color:var(--gold);font:800 .75rem/1.2 system-ui;text-transform:uppercase;letter-spacing:.12em}.race-copy h3{margin:.2rem 0!important;color:var(--text)!important}.race-copy p:last-child{margin:.3rem 0 1rem!important;color:var(--muted);font-size:.95rem}.mode,.controls{display:flex;flex-wrap:wrap;gap:.65rem}.mode button,.controls button{cursor:pointer;border:1px solid var(--border);border-radius:.75rem;padding:.65rem .9rem;background:var(--panel);color:var(--text);font:750 .82rem/1.2 system-ui;transition:transform .18s,background .18s,box-shadow .18s}.mode button:hover,.controls button:hover{transform:translateY(-2px)}button:focus-visible{outline:3px solid color-mix(in srgb,var(--purple) 45%,transparent);outline-offset:2px}.mode button[aria-pressed="true"]{background:var(--db);color:var(--dbtext);border-color:var(--db)}.controls{justify-content:flex-end;margin-top:1rem}.controls button:last-child{background:var(--purple);border-color:var(--purple);color:#fff}
  .race-board{position:relative;min-height:17rem;margin:1.2rem 0;overflow:hidden;border:1px solid var(--border);border-radius:1rem;background:radial-gradient(circle at 50% 45%,color-mix(in srgb,var(--blue) 10%,transparent),transparent 24%),var(--board)}.worker,.database{position:absolute;z-index:5;top:2.1rem;display:flex;min-height:6.2rem;flex-direction:column;align-items:center;justify-content:center;text-align:center;border-radius:1rem;border:2px solid var(--border);background:var(--panel);color:var(--text)}.worker{width:18%}.worker-a{left:3%}.worker-b{right:3%}.worker span{display:grid;place-items:center;width:2.2rem;height:2.2rem;margin-bottom:.35rem;border-radius:50%;background:var(--blue);color:#fff;font:900 .9rem/1 system-ui}.worker-b span{background:var(--purple)}.worker strong,.database strong{font:800 clamp(.65rem,1.4vw,.9rem)/1.2 system-ui}.database{left:39%;width:22%;border-color:var(--db);background:var(--db);color:var(--dbtext);box-shadow:0 12px 25px rgba(0,0,0,.2)}.database span,.database small{font:700 .58rem/1.2 system-ui;color:#cbd5e1}.database strong{margin:.38rem 0;color:var(--gold)}.db-top{position:absolute;top:-.45rem;width:64%;height:.8rem;border:2px solid var(--gold);border-radius:50%;background:var(--db)}
  .route{position:absolute;z-index:1;top:8.55rem;height:3px;background:linear-gradient(90deg,var(--blue),var(--border))}.route-a{left:20%;width:20%}.route-b{right:20%;width:20%;background:linear-gradient(90deg,var(--border),var(--purple))}.claim-token{position:absolute;z-index:9;top:7.7rem;display:grid;place-items:center;min-width:3.5rem;padding:.35rem .45rem;border-radius:.65rem;color:#fff;box-shadow:0 8px 20px rgba(0,0,0,.25);font:850 .58rem/1 system-ui;transition:left .65s cubic-bezier(.2,.9,.2,1),right .65s cubic-bezier(.2,.9,.2,1),top .55s cubic-bezier(.2,.9,.2,1),transform .55s,opacity .35s}.claim-token small{font-size:.45rem}.token-a{left:12%;background:var(--blue)}.token-b{right:12%;background:var(--purple)}
  .lock-gate{position:absolute;z-index:10;left:61%;top:2.65rem;width:2.5rem;height:5rem;transform:translateX(-50%) scaleY(.1);transform-origin:top;opacity:0;border:3px solid var(--gold);border-radius:.3rem;background:repeating-linear-gradient(135deg,var(--db) 0 7px,var(--gold) 7px 10px);transition:transform .45s cubic-bezier(.2,1.4,.4,1),opacity .2s}.lock-gate i{position:absolute;left:50%;top:-1.15rem;width:1.4rem;height:1.5rem;transform:translateX(-50%);border:3px solid var(--gold);border-bottom:0;border-radius:.8rem .8rem 0 0}.lock-gate span{position:absolute;left:50%;bottom:.35rem;transform:translateX(-50%);padding:.16rem .25rem;background:var(--db);color:#fff;font:900 .45rem/1 system-ui}.wait-wave{position:absolute;z-index:8;left:63%;top:3.65rem}.wait-wave i{position:absolute;width:1.7rem;height:1.7rem;border:2px solid var(--red);border-radius:50%;opacity:0}.effect-tray{position:absolute;left:34%;right:34%;bottom:1rem;text-align:center;color:var(--muted);font:750 .58rem/1 system-ui}.effect-tray>div{display:flex;justify-content:center;gap:.5rem;margin-top:.4rem}.effect-tray i{display:grid;place-items:center;width:2rem;height:2rem;border-radius:50%;background:var(--green);color:#fff;font:900 .8rem/1 system-ui;opacity:0;transform:translateY(18px) scale(.2);transition:opacity .3s,transform .55s cubic-bezier(.2,1.7,.4,1)}
  .race-board[data-step="1"] .token-a,.race-board[data-step="2"] .token-a{left:43%;transform:scale(1.08)}.race-board[data-step="2"] .token-b{right:43%;transform:scale(1.08)}.race-board[data-step="3"] .token-a,.race-board[data-step="4"] .token-a{left:35%;top:10.8rem}.race-board[data-mode="unsafe"][data-step="3"] .token-b,.race-board[data-mode="unsafe"][data-step="4"] .token-b{right:35%;top:10.8rem}.race-board[data-mode="atomic"][data-step="2"] .token-b,.race-board[data-mode="atomic"][data-step="3"] .token-b{right:39%;animation:token-collision .55s ease}.race-board[data-mode="atomic"][data-step="4"] .token-b{right:16%;top:10.8rem}.race-board[data-mode="atomic"]:is([data-step="1"],[data-step="2"],[data-step="3"],[data-step="4"]) .lock-gate{opacity:1;transform:translateX(-50%) scaleY(1)}.race-board[data-mode="atomic"]:is([data-step="2"],[data-step="3"]) .wait-wave i{animation:wait-ring 1.2s infinite}.race-board[data-mode="atomic"] .wait-wave i:nth-child(2){animation-delay:.25s}.race-board[data-mode="atomic"] .wait-wave i:nth-child(3){animation-delay:.5s}.race-board[data-mode="unsafe"][data-step="4"] .effect-tray i,.race-board[data-mode="unsafe"][data-step="3"] .effect-tray i{opacity:1;transform:none}.race-board[data-mode="atomic"]:is([data-step="3"],[data-step="4"]) .effect-tray i:first-child{opacity:1;transform:none}.race-board[data-result="danger"]{animation:danger-board .55s ease}.race-board[data-result="danger"] .effect-tray i{background:var(--red)}.race-board[data-result="safe"] .database{animation:safe-db .8s ease}.race-board[data-result="safe"] .token-b{background:var(--green)}
  .event-log{display:grid;grid-template-columns:auto 1fr;gap:.8rem;align-items:center;padding:.8rem 1rem;border-radius:.8rem;background:var(--log);color:var(--text)}.event-log span{color:var(--gold);font:850 .7rem/1 system-ui;text-transform:uppercase}.event-log p,.lesson{margin:0!important;font-size:.85rem}.lesson{margin-top:1rem!important;padding-left:.8rem;border-left:3px solid var(--purple);font-weight:750;color:var(--text)}
  @keyframes token-collision{40%{transform:translateX(-10px) rotate(-6deg)}65%{transform:translateX(7px) rotate(4deg)}}@keyframes wait-ring{0%{opacity:.7;transform:scale(.2)}100%{opacity:0;transform:scale(2)}}@keyframes danger-board{25%,75%{transform:translateX(-4px)}50%{transform:translateX(4px);box-shadow:0 0 0 5px color-mix(in srgb,var(--red) 25%,transparent)}}@keyframes safe-db{50%{box-shadow:0 0 0 12px color-mix(in srgb,var(--green) 25%,transparent)}}
  @media(max-width:650px){.race-board{min-height:19rem}.worker{top:1.5rem;width:25%}.worker-a{left:2%}.worker-b{right:2%}.database{top:1.5rem;left:36%;width:28%}.route-a{left:26%;width:11%}.route-b{right:26%;width:11%}.token-a{left:14%}.token-b{right:14%}.race-board[data-step="1"] .token-a,.race-board[data-step="2"] .token-a{left:42%}.race-board[data-step="2"] .token-b{right:42%}.race-board[data-step="3"] .token-a,.race-board[data-step="4"] .token-a{left:25%;top:11.5rem}.race-board[data-mode="unsafe"][data-step="3"] .token-b,.race-board[data-mode="unsafe"][data-step="4"] .token-b{right:25%;top:11.5rem}.effect-tray{left:20%;right:20%;bottom:1.2rem}.controls{justify-content:stretch}.controls button{flex:1}}

---
import SectionHeader from "../../components/SectionHeader.astro";
import { skills } from "../../data";
---

<section class="my-32">
    <div class="container">
        <SectionHeader title="About Me" />
        <div class="grid grid-cols-1 gap-6 align-top md:grid-cols-2">
            <div class="self-center order-2 md:order-1">
                <p class="about-me-p">
                    I'm a <b>software engineer</b> at WPXPO building and scaling
                    production web products used by 60K+ active users. I own
                    features end to end—from <b>system design</b> and
                    <b>API development</b> to testing, deployment, and long-term
                    maintenance.
                </p>
                <p class="about-me-p">
                    My strengths include full-stack engineering,
                    <b>backend development</b>, <b>performance optimization</b>,
                    <b>CI/CD</b>, <b>automated testing</b>, and maintainable
                    <b>system architecture</b>. I enjoy solving complex product
                    and platform problems, improving developer workflows, and
                    delivering reliable software end to end.
                </p>
            </div>
            <div
                id="myCanvasContainer"
                class="order-1 justify-self-center md:order-2"
            >
                <canvas
                    id="myCanvas"
                    width="700px"
                    height="400px"
                    style="width: 100%; overflow-x: visible;"
                >
                    <p>
                        Anything in here will be replaced on browsers that
                        support the canvas element
                    </p>
                    <ul>
                        {
                            skills.map((item) => (
                                <li>
                                    <a
                                        href="/"
                                        onclick="return false;"
                                        class="cursor-default"
                                    >
                                        {item}
                                    </a>
                                </li>
                            ))
                        }
                    </ul>
                </canvas>
            </div>
        </div>
    </div>
</section>

<style lang="scss">
    .about-me-p {
        text-align: justify;
        text-justify: inter-word;
        line-height: 1.625; /* Tailwind leading-relaxed */
        margin-bottom: 0.5rem; /* Tailwind mb-2 */
    }
</style>

<script src="/tagCanvas.min.js" type="text/javascript"></script>
<script>
    window.onload = function () {
        try {
            TagCanvas.initial = [0.1, -0.1];
            TagCanvas.outlineMethod = "none";
            TagCanvas.noSelect = true;
            TagCanvas.minSpeed = 0.05;
            TagCanvas.textFont = "Jetbrains Mono Variable";
            TagCanvas.fadeIn = 800;
            TagCanvas.depth = 0.97;
            TagCanvas.wheelZoom = false;
            TagCanvas.shadowOffset = [1, 1];
            TagCanvas.stretchX = 1.7;
            TagCanvas.shuffleTags = true;
            TagCanvas.Start("myCanvas");
        } catch (e) {
            document.getElementById("myCanvasContainer").style.display = "none";
        }
    };
</script>
